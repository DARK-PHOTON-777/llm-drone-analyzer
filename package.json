{
	"name": "llm-drone-analyzer",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"api/*"
	],
	"scripts": {
		"prepare": "husky",
		"precommit": "lint-staged",
		"prepush": "npm run validate",
		"build": "npm run build --prefix rust && npm run build --prefix web",
		"dev": "npm run build --prefix rust && npm run dev --prefix web",
		"validate": "biome check . && npm run validate --workspaces --if-present",
		"format": "biome format --write ."
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx}": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7"
	},
	"dependencies": {
		"@netlify/functions": "^5.3.0",
		"@openrouter/agent": "^0.7.0",
		"@types/node": "^25.9.1",
		"pino": "^10.3.1"
	}
}
